<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/bg_card">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <!-- Username -->
            <TextView
                android:id="@+id/admin_res_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reader: Molka"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/admin_res_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/chip_background_selected"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <!-- Book Title -->
        <TextView
            android:id="@+id/admin_res_book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book: Clean Code"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Confirmed Date -->
        <TextView
            android:id="@+id/admin_res_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmed for: -"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Actions Row -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end">

            <!-- Confirm Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/admin_res_btn_confirm"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Confirm"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/button_gradient"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp" />

            <!-- Cancel Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/admin_res_btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Cancel Reservation"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/chip_background_unselected"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
