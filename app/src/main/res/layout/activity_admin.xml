<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Main Container -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/primary">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/admin_welcome_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin Dashboard"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true" />

                <!-- Logout Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_admin_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Logout"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/chip_background_selected"
                    android:backgroundTint="@color/white"
                    android:paddingHorizontal="14dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sub-header: Navigation Switch Tabs and Add button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <!-- Books Tab Chip -->
                <TextView
                    android:id="@+id/chip_manage_books"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Books"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/chip_background_selected"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Reservations Tab Chip -->
                <TextView
                    android:id="@+id/chip_manage_reservations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reservations"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/chip_background_unselected"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Add Book Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_admin_add_book"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+ Book"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/button_gradient"
                android:paddingHorizontal="14dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />

        </RelativeLayout>

        <!-- Frame Layout for Content Screens -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Books List Screen -->
            <LinearLayout
                android:id="@+id/container_manage_books"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <ListView
                    android:id="@+id/lv_admin_books"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false" />
            </LinearLayout>

            <!-- Reservations List Screen -->
            <LinearLayout
                android:id="@+id/container_manage_reservations"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <ListView
                    android:id="@+id/lv_admin_reservations"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false" />

                <!-- Empty State Reservations -->
                <TextView
                    android:id="@+id/tv_admin_reservations_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No user reservations found."
                    android:textColor="@color/text_muted"
                    android:textSize="16sp"
                    android:layout_gravity="center"
                    android:layout_marginTop="64dp"
                    android:visibility="gone" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
