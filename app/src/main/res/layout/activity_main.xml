<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Main Content Container -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp">

        <!-- Top Header Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/primary">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <!-- Header Content -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true">

                        <TextView
                            android:id="@+id/welcome_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome back,\nReader!"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvReservedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reserved Books: 0"
                            android:textColor="#DCD8FF"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Profile Avatar Frame -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:cardCornerRadius="27.5dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#20FFFFFF">

                        <ImageView
                            android:id="@+id/user_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/logo"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="Avatar" />
                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

                <!-- Search Input Field Container -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/card_background"
                    android:elevation="1dp"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/search_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_secondary"
                        android:contentDescription="Search Icon" />

                    <EditText
                        android:id="@+id/search_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@id/search_icon"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:hint="Search books or authors..."
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </RelativeLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Category Chip Filters (Horizontal Scroll) -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="12dp">

                <LinearLayout
                    android:id="@+id/category_chips_container"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <!-- All Chip -->
                    <TextView
                        android:id="@+id/chip_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Books"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/chip_background_selected"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Programming Chip -->
                    <TextView
                        android:id="@+id/chip_dev"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Development"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/chip_background_unselected"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- AI & Networking Chip -->
                    <TextView
                        android:id="@+id/chip_ai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI &amp; Net"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/chip_background_unselected"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Architecture Chip -->
                    <TextView
                        android:id="@+id/chip_arch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Architecture"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/chip_background_unselected"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Databases Chip -->
                    <TextView
                        android:id="@+id/chip_databases"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Databases"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/chip_background_unselected"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Data Science Chip -->
                    <TextView
                        android:id="@+id/chip_datascience"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data Science"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/chip_background_unselected"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Security Chip -->
                    <TextView
                        android:id="@+id/chip_security"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Security"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/chip_background_unselected"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Cloud Chip -->
                    <TextView
                        android:id="@+id/chip_cloud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cloud"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/chip_background_unselected"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Mobile Chip -->
                    <TextView
                        android:id="@+id/chip_mobile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobile"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/chip_background_unselected"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Book List -->
        <ListView
            android:id="@+id/lvBooks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"/>

    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_card"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
